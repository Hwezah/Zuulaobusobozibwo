# Copy to .env.local and fill in. Everything here is optional: with nothing set
# the app runs in prototype mode (orders live only in the browser that created
# them; the admin panel shows demo data; SMS is logged, not sent).

# --- Supabase: server persistence for orders / tickets --------------------
# Set all three so submitted orders persist and the team panel shows real
# orders on any device. Settings -> API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin SMS alerts: text the team when a buyer submits an order --------
# Comma-separated recipient numbers in E.164, e.g.
#   ADMIN_SMS_RECIPIENTS=+256757217681,+256777667080
ADMIN_SMS_RECIPIENTS=

# SMS gateway. Wired provider: Africa's Talking (src/lib/sms.ts).
#   SMS_PROVIDER   africastalking
#   SMS_API_KEY    your Africa's Talking API key
#   SMS_SENDER_ID  approved sender ID / short code (optional in sandbox)
#   AT_USERNAME    "sandbox" to test free in the AT simulator; your live app
#                  username for production ("sandbox" auto-routes to the sandbox
#                  API, so no real SMS is sent and nothing is charged).
# A registered sender ID is a launch blocker: apply early, approval takes days.
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_SENDER_ID=
AT_USERNAME=sandbox

# --- Ticket QR signing (optional) -----------------------------------------
# Set a long random secret to HMAC-sign ticket codes so a door scanner can
# validate them offline. Leave blank and the QR payload is just the code.
TICKET_SIGNING_SECRET=

# --- Admin panel login --------------------------------------------------------
# One shared team passcode (no accounts). The server checks it and sets a signed
# 12-hour cookie; every /api/admin/* route requires that cookie. REQUIRED in
# production: with ADMIN_PIN unset, nobody can sign in (fails closed). Use a long
# passcode, not a 4-digit PIN. Changing it signs everyone out.
ADMIN_PIN=
# Optional: separate signing key for the session cookie (else derived from the PIN).
ADMIN_SESSION_SECRET=

# --- Scheduled keep-alive (vercel.json) ---------------------------------------
# Vercel calls /api/cron/keepalive daily so the free Supabase project never idles
# into a pause. Optional: set CRON_SECRET and Vercel sends it as a Bearer token.
CRON_SECRET=
